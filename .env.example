# =========================================================
# Education Forecast Platform - Environment Configuration
# =========================================================
# Copy this file to .env and fill in your actual credentials.
# Never commit your real secret keys to GitHub.

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Machine Learning API (FastAPI backend service)
# When running python ml/api.py locally, default is port 8000
VITE_ML_API_URL=http://localhost:8000

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development

